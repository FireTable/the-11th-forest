# ============================================================================
# The 11th Forest — environment variables (sample)
# ----------------------------------------------------------------------------
# Copy to `.env` (gitignored) and fill in real values.
#
# Intentionally NO `VITE_` prefix: Vite only exposes `VITE_*` to the
# browser, and these keys must NOT ship to the client. Wire them in via
# a backend proxy or build-time injection. Node-side scripts under
# `scripts/` can read them with `process.env.*`.
# ============================================================================

# --- AI image generation (Google "Nano-banana 2" = Gemini 3 Pro Image) ------
# Docs:  https://ai.google.dev/gemini-api/docs/image-generation
# SDK:   https://www.npmjs.com/package/@google/genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1

# --- Music generation (MiniMax) ----------------------------------------------
MiniMax_API_KEY=
MiniMax_MUSIC_MODEL=
MiniMax_ENDPOINT=

# --- SFX generation (ElevenLabs) --------------------------------------------
# Get a key at:  https://elevenlabs.io  →  Profile → API Keys
# Free tier: ~50 generations/month, non-commercial only. Upgrade to
# Starter ($5/mo) for commercial use before public release.
# Used by:  scripts/elevenlabs-sfx.ts
ELEVENLABS_API_KEY=
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io
# Optional: defaults to "v1" + path /v1/sound-generation
# ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2

# --- Game / debug panel ------------------------------------------------------
# Set to `1` to enable the debug admin panel (hotkey F2 to toggle).
DEBUG_PANEL=1