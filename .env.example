# ============================================================================
# The 11th Forest — environment variables (sample)
# ----------------------------------------------------------------------------
# Copy to `.env` (gitignored) and fill in real values.
#
# Intentionally NO `VITE_` prefix: Vite only exposes `VITE_*` to the
# browser, and these keys must NOT ship to the client. Wire them in via
# a backend proxy or build-time injection. Node-side scripts under
# `scripts/` can read them with `process.env.*`.
# ============================================================================

# --- AI image generation (Google "Nano-banana 2" = Gemini 3 Pro Image) ------
# Docs:  https://ai.google.dev/gemini-api/docs/image-generation
# SDK:   https://www.npmjs.com/package/@google/genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-image
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# --- Music generation (MiniMax) ----------------------------------------------
MiniMax_API_KEY=
MiniMax_MUSIC_MODEL=
MiniMax_ENDPOINT=

# --- Game / debug panel ------------------------------------------------------
# Set to `1` to enable the debug admin panel (hotkey F2 to toggle).
DEBUG_PANEL=1