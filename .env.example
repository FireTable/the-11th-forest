# ============================================================================
# The 11th Forest — environment variables (sample)
# ----------------------------------------------------------------------------
# Copy to `.env` (gitignored) and fill in real values.
# Only variables prefixed with `VITE_` are exposed to the browser by Vite.
# Anything else is build-time only and won't reach the client.
# ============================================================================

# --- AI image generation (Google "Nano-banana 2" = Gemini 3 Pro Image) --------
# Browser-side (dev only). DO NOT ship these to production — use a backend
# proxy in production to keep the key off the client.
#
# "Nano-banana 2" is Google's codename for the Gemini 3 Pro Image /
# Gemini 3.1 Flash Image native multimodal image model.
# Docs:  https://ai.google.dev/gemini-api/docs/image-generation
# SDK:   https://www.npmjs.com/package/@google/genai
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-pro-image
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# --- Music generation (MiniMax) ----------------------------------------------
VITE_MiniMax_API_KEY=
VITE_MiniMax_MUSIC_MODEL=

# --- Game / debug panel ------------------------------------------------------
# Set to `1` to enable the debug admin panel (hotkey F2 to toggle).
VITE_DEBUG_PANEL=1